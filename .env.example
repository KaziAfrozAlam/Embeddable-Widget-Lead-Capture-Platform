# ---- App ----
APP_ENV=development
API_BASE_URL=http://localhost:8000
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 0 = ignore X-Forwarded-For (spoof-proof); N = trust that many reverse proxies.
# In production behind a proxy set TRUST_PROXY_COUNT to the proxy chain length.
TRUST_PROXY_COUNT=0

# SQLite for zero-config local dev; swap for Postgres via docker compose:
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
DATABASE_URL=sqlite:///./data/app.db

# ---- Rate limiting (fixed window) ----
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_WIDGET_WINDOW_SECONDS=60
RATE_LIMIT_WIDGET_MAX=20

# ---- Payload guard ----
MAX_PAYLOAD_BYTES=16384

# ---- Geo enrichment ----
# live  = use the real free providers
# mock  = deterministic canned providers (toggle availability below); used by tests & EVIDENCE
GEO_MODE=live
GEO_PROVIDER_A_URL=https://ip-api.com/json/
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
# ipapi.co free tier works without a key; add one if you have it
GEO_PROVIDER_B_API_KEY=
GEO_TIMEOUT_SECONDS=2
# mock toggles (only read when GEO_MODE=mock)
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true

# ---- Side effects (email/webhook) ----
# console = pretty log line   |   stderr = tag-able log for grepping
# fail    = always raise (prove failure never blocks the submission)
# smtp    = send real mail via SMTP (Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025)
MAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
WEBHOOK_URL=

# ---- Background worker ----
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3